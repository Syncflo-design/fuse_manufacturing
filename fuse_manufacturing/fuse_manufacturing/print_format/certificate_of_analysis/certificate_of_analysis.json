 "doctype": "Print Format",
 "font_size": 0,
 "html": "<div class=\"coa\">\n\t<div class=\"coa-head\">\n\t\t<div>\n\t\t\t<div class=\"coa-title\">Certificate of Analysis</div>\n\t\t\t<div class=\"coa-ref\">{{ doc.name }}</div>\n\t\t</div>\n\t\t<div class=\"coa-status coa-{{ doc.status | lower }}\">{{ doc.status }}</div>\n\t</div>\n\n\t<table class=\"coa-facts\">\n\t\t<tr>\n\t\t\t<th>Product</th><td>{{ doc.item_code }} &mdash; {{ doc.item_name or \"\" }}</td>\n\t\t\t<th>Batch</th><td>{{ doc.batch_no or \"&mdash;\" }}</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<th>Inspection</th><td>{{ doc.inspection_type }}</td>\n\t\t\t<th>Date</th><td>{{ frappe.utils.formatdate(doc.report_date, \"d MMMM yyyy\") }}</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<th>Against</th><td>{{ doc.reference_type }} {{ doc.reference_name }}</td>\n\t\t\t<th>Sample size</th><td>{{ doc.sample_size }}</td>\n\t\t</tr>\n\t</table>\n\n\t<table class=\"coa-results\">\n\t\t<thead>\n\t\t\t<tr>\n\t\t\t\t<th>Parameter</th>\n\t\t\t\t<th>Specification</th>\n\t\t\t\t<th class=\"num\">Minimum</th>\n\t\t\t\t<th class=\"num\">Maximum</th>\n\t\t\t\t<th class=\"num\">Result</th>\n\t\t\t</tr>\n\t\t</thead>\n\t\t<tbody>\n\t\t\t{% for row in doc.readings %}\n\t\t\t<tr>\n\t\t\t\t<td>{{ row.specification }}</td>\n\t\t\t\t<td>{{ row.value or \"\" }}</td>\n\t\t\t\t<td class=\"num\">{{ row.min_value if row.numeric else \"\" }}</td>\n\t\t\t\t<td class=\"num\">{{ row.max_value if row.numeric else \"\" }}</td>\n\t\t\t\t<td class=\"num\"><b>{{ row.reading_value if row.numeric else (row.reading_1 or \"\") }}</b></td>\n\t\t\t</tr>\n\t\t\t{% endfor %}\n\t\t</tbody>\n\t</table>\n\n\t{% if doc.remarks %}\n\t<div class=\"coa-remarks\"><b>Remarks</b><br>{{ doc.remarks }}</div>\n\t{% endif %}\n\n\t<table class=\"coa-sign\">\n\t\t<tr>\n\t\t\t<td>\n\t\t\t\t<div class=\"coa-label\">Inspected by</div>\n\t\t\t\t<div class=\"coa-name\">{{ frappe.db.get_value(\"User\", doc.inspected_by, \"full_name\") or doc.inspected_by }}</div>\n\t\t\t</td>\n\t\t\t<td>\n\t\t\t\t<div class=\"coa-label\">Released by</div>\n\t\t\t\t<div class=\"coa-name\">{{ doc.verified_by or \"&mdash;\" }}</div>\n\t\t\t</td>\n\t\t\t<td>\n\t\t\t\t<div class=\"coa-label\">Measured on</div>\n\t\t\t\t<div class=\"coa-name\">\n\t\t\t\t\t{%- if doc.custom_instrument -%}\n\t\t\t\t\t\t{%- set instrument = frappe.get_doc(\"Fuse Measuring Instrument\", doc.custom_instrument) -%}\n\t\t\t\t\t\t{{ instrument.instrument_id }}\n\t\t\t\t\t\t<span class=\"coa-cal\">calibration valid to {{ frappe.utils.formatdate(instrument.calibration_due, \"d MMM yyyy\") }}</span>\n\t\t\t\t\t{%- else -%}\n\t\t\t\t\t\t&mdash;\n\t\t\t\t\t{%- endif -%}\n\t\t\t\t</div>\n\t\t\t</td>\n\t\t</tr>\n\t</table>\n\n\t<div class=\"coa-foot\">\n\t\tResults relate only to the batch identified above. Issued by {{ doc.company or frappe.defaults.get_user_default(\"Company\") }}.\n\t</div>\n</div>\n\n<style>\n\t.coa { font-size: 11pt; }\n\t.coa-head { display: flex; justify-content: space-between; align-items: flex-start;\n\t\tborder-bottom: 2px solid #111; padding-bottom: 8px; margin-bottom: 14px; }\n\t.coa-title { font-size: 18pt; font-weight: 700; letter-spacing: -0.01em; }\n\t.coa-ref { font-size: 10pt; color: #555; }\n\t.coa-status { font-size: 10pt; font-weight: 700; text-transform: uppercase;\n\t\tletter-spacing: 0.08em; border: 2px solid; padding: 4px 10px; }\n\t.coa-accepted { color: #17643F; border-color: #17643F; }\n\t.coa-rejected { color: #A32020; border-color: #A32020; }\n\t.coa-cancelled { color: #666; border-color: #666; }\n\t.coa-facts { width: 100%; border-collapse: collapse; margin-bottom: 16px; }\n\t.coa-facts th { text-align: left; font-size: 8.5pt; text-transform: uppercase;\n\t\tletter-spacing: 0.06em; color: #666; padding: 3px 10px 3px 0; width: 1%;\n\t\twhite-space: nowrap; font-weight: 600; }\n\t.coa-facts td { padding: 3px 24px 3px 0; }\n\t.coa-results { width: 100%; border-collapse: collapse; margin-bottom: 16px; }\n\t.coa-results th { text-align: left; font-size: 8.5pt; text-transform: uppercase;\n\t\tletter-spacing: 0.06em; color: #666; border-bottom: 1px solid #111;\n\t\tpadding: 6px 8px 6px 0; }\n\t.coa-results td { padding: 6px 8px 6px 0; border-bottom: 1px solid #E2E2E2; }\n\t.coa-results .num { text-align: right; font-variant-numeric: tabular-nums; }\n\t.coa-remarks { border-left: 3px solid #CCC; padding-left: 10px; margin-bottom: 16px; }\n\t.coa-sign { width: 100%; border-collapse: collapse; margin-top: 26px; }\n\t.coa-sign td { width: 33%; border-top: 1px solid #111; padding-top: 6px;\n\t\tvertical-align: top; padding-right: 16px; }\n\t.coa-label { font-size: 8.5pt; text-transform: uppercase; letter-spacing: 0.06em;\n\t\tcolor: #666; }\n\t.coa-name { font-weight: 600; }\n\t.coa-cal { display: block; font-size: 8.5pt; font-weight: 400; color: #666; }\n\t.coa-foot { margin-top: 20px; font-size: 9pt; color: #666; }\n</style>\n",
